{
  "name": "whatsapp-bot-entreprise-full",
  "version": "1.0.0",
  "description": "Bot WhatsApp pour la gestion d'entreprise avec interface web",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "frontend": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "frontend:start": "cd frontend && npm start",
    "dev:full": "concurrently \"npm run dev\" \"npm run frontend\"",
    "build": "npm run frontend:build",
    "install:all": "npm install && cd frontend && npm install",
    "test": "jest",
    "test-setup": "node test-setup.js"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "entreprise",
    "presence",
    "permissions",
    "nextjs"
  ],
  "author": "Votre Entreprise",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.61.0",
    "@huggingface/inference": "^4.7.1",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cohere-ai": "^7.18.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "mysql2": "^3.6.5",
    "node-cron": "^3.0.3",
    "openai": "^5.20.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.1",
    "whatsapp-web.js": "^1.34.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2"
  }
}
