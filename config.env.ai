# Configuration IA pour le bot WhatsApp
# Copiez ce fichier vers .env et ajustez selon vos besoins

# ===========================================
# CONFIGURATION HUGGING FACE
# ===========================================

# Clé API Hugging Face (obligatoire pour utiliser les modèles)
# Obtenez votre clé sur: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# ===========================================
# CONFIGURATION IA CONVERSATIONNELLE
# ===========================================

# Activer l'IA conversationnelle (true/false)
AI_CONVERSATIONAL_ENABLED=true

# Fournisseur IA (huggingface, openai, local)
AI_PROVIDER=huggingface

# Modèle à utiliser (voir config/ai-models.js pour les options)
# Recommandations selon vos ressources:
# - Faibles ressources: microsoft/DialoGPT-small
# - Ressources moyennes: microsoft/DialoGPT-medium  
# - Bonnes ressources: microsoft/DialoGPT-large
# - Très bonnes ressources: facebook/blenderbot-1B-distill
AI_MODEL=microsoft/DialoGPT-medium

# Longueur maximale des réponses (tokens)
AI_MAX_LENGTH=200

# Créativité des réponses (0.0 = très prévisible, 1.0 = très créatif)
AI_TEMPERATURE=0.8

# ===========================================
# CONFIGURATION AVANCÉE
# ===========================================

# Seuil de confiance pour traiter les messages (0.0 - 1.0)
AI_CONFIDENCE_THRESHOLD=0.3

# Activer l'analyse de sentiment (true/false)
AI_SENTIMENT_ANALYSIS=true

# Activer la détection de sujets (true/false)
AI_TOPIC_DETECTION=true

# Langue par défaut
AI_LANGUAGE=fr

# ===========================================
# CONFIGURATION DE FALLBACK
# ===========================================

# Activer le mode dégradé si l'IA échoue (true/false)
AI_FALLBACK_ENABLED=true

# Message à envoyer si l'IA n'est pas disponible
AI_UNAVAILABLE_MESSAGE="🤖 Désolé, mon système d'IA est temporairement indisponible. Je peux toujours vous aider avec les présences et permissions !"

# ===========================================
# CONFIGURATION DE DÉBOGAGE
# ===========================================

# Activer les logs détaillés de l'IA (true/false)
AI_DEBUG_LOGS=true

# Sauvegarder toutes les réponses IA (true/false)
AI_SAVE_RESPONSES=true
